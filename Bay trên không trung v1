player.CharacterAdded:Connect(function(char)

	character = char

	humanoid =
		char:WaitForChild("Humanoid")

	root =
		char:WaitForChild("HumanoidRootPart")

	cleanupFlight()

	if flying then

		task.wait(0.3)

		if character
			and humanoid
			and root then

			startFlight()

		end

	end

end)

--========================================================
-- CHARACTER REMOVING
--========================================================

player.CharacterRemoving:Connect(function()

	cleanupFlight()

end)

